{% extends 'auth.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="flex flex-col gap-6">
        <form method="post">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <twig:Text class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_task_index') }}">Visit Home</a>
                </twig:Text>
            {% endif %}

            <twig:Heading class="text-center">Please sign in</twig:Heading>
            <twig:SubHeading class="text-center mt-2">Enter your email and password below to log in</twig:SubHeading>

            <twig:Input for="username"
                        id="username"
                        type="email"
                        name="_username"
                        class="form-control"
                        label="Email"
                        placeholder="you@example.com"
                        value="{{ last_username }}"
                        autocomplete="email"
                        required="required"
                        autofocus="autofocus"
            />

            <twig:Input for="password"
                        id="password"
                        type="password"
                        name="_password"
                        class="form-control"
                        label="Password"
                        placeholder="Password"
                        value="{{ last_username }}"
                        autocomplete="current-password"
                        required="required"
            />

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                   value="{{ csrf_token('authenticate') }}">

            <twig:Button type="submit" text="Sign in" class="mt-2" />

            <twig:Text class="mt-3 text-center">
                Don't have an account? <a href="{{ path('app_register') }}">Sign up</a>
            </twig:Text>
        </form>
    </div>
{% endblock %}
