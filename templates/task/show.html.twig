{% extends 'base.html.twig' %}

{% block title %}Task{% endblock %}

{% block body %}
    <h1>Task</h1>

    <table class="table table--type-task">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ task.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ task.name }}</td>
            </tr>
            <tr>
                <th>Is_complete</th>
                <td>{{ task.isComplete ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Created</th>
                <td>{{ task.createdAt|date("d/m/Y H:i") }}</td>
            </tr>
            <tr>
                <th>Updated</th>
                <td>{{ task.updatedAt|date("d/m/Y H:i") }}</td>
            </tr>
        </tbody>
    </table>

    <div class="w-40">
        <twig:SecondaryButton class="mb-4" text="Edit" href="{{ path('app_task_edit', {'id': task.id}) }}" type="button" />
    </div>

    {{ include('task/_delete_form.html.twig') }}

    <div class="w-40">
        <twig:SecondaryButton class="mb-4" text="Back to list" href="{{ path('app_task_index') }}" type="button" />
    </div>
{% endblock %}
