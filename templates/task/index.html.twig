{% extends 'base.html.twig' %}

{% block title %}Task index{% endblock %}

{% block body %}
    <twig:Heading class="text-center">Task index</twig:Heading>

    <table class="table table--type-task">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Is complete</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for task in tasks %}
            <tr>
                <td>{{ task.id }}</td>
                <td>{{ task.name }}</td>
                <td>{{ task.isComplete ? 'Yes' : 'No' }}</td>
                <td>
                    {% if app.user and task.user and app.user.id == task.user.id %}
                    <a href="{{ path('app_task_show', {'id': task.id}) }}">show</a>
                    |&nbsp;<a href="{{ path('app_task_edit', {'id': task.id}) }}">edit</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">
                    no records found
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="w-40 mt-6">
        <twig:Button type="button" text="Create new" href="{{ path('app_task_new') }}" />
    </div>
{% endblock %}
